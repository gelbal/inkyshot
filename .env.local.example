# Copy to .env.local and fill in values locally. .env.local is gitignored.

# balenaCloud automation token. Leave blank while using browser login only.
BALENA_API_TOKEN=

# They Said So quote API token. Not needed if MODE=weather and you do not use quote/alternate.
QOD_API_TOKEN=

# Fleet/device settings for this project.
BALENA_FLEET_NAME=inkyshot-firat
BALENA_DEVICE_TYPE=raspberry-pi
BALENA_INITIAL_DEVICE_NAME=inkyshot-zero

# Wi-Fi used when configuring a fresh balenaOS image.
BALENA_WIFI_SSID=
BALENA_WIFI_KEY=

# Inkyshot runtime settings.
MODE=weather
WEATHER_LOCATION=Barcelona, Spain
SCALE=C
TZ=Europe/Madrid
FONT=AmaticSC
TEST_CHARACTER=a
